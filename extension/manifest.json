{
  "manifest_version": 3,
  "name": "Mono",
  "version": "0.2.1",
  "description": "A quiet, terminal-style reading view for the web. Starts with X.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Mono",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "css": ["looks.css", "sites/x.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
